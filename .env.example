# Application Environment
ENVIRONMENT=development
DEBUG=false
BASE_URL=http://localhost:8000

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=linklite
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/linklite

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=86400
REDIS_NEGATIVE_CACHE_TTL_SECONDS=60

# Rate Limiting Configuration (Per client IP)
RATE_LIMIT_CREATE_PER_MINUTE=10
RATE_LIMIT_REDIRECT_PER_MINUTE=300
TRUST_PROXY_HEADERS=false

# Analytics Worker
ANALYTICS_FLUSH_INTERVAL_SECONDS=10
